---
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import Lightbox from './Lightbox.astro';
import { gallery } from '../data/site';

// Up to 4 cards show on each side of the centre; with 10+ the loop wraps around out of sight.
const MIN = 10;
const slides = Array.from({ length: Math.max(MIN, gallery.length) }, (_, i) => gallery[i % gallery.length]);

// Large versions for the lightbox, one per unique photo
const full = await Promise.all(
  gallery.map((g) => getImage({ src: g.src, width: Math.min(1800, g.src.width), format: 'webp' })),
);
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="section gallery" id="life">
  <div class="container gallery__head">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Живе життя спільноти</span>
      <h2>Так виглядають наші будні</h2>
      <p>Заходи, навчання, творчість, толоки та свята — моменти, заради яких ми все це робимо.</p>
    </div>
  </div>

  <div
    class="carousel"
    data-carousel
    role="region"
    aria-roledescription="карусель"
    aria-label="Фото з життя спільноти"
    tabindex="0"
    data-reveal
  >
    <div class="carousel__stage" data-carousel-stage>
      {slides.map((s, i) => (
        <figure class="slide" data-slide data-photo={i % gallery.length} data-caption={s.caption}>
          <Image
            src={s.src}
            alt={s.alt}
            widths={[480, 960]}
            sizes="(min-width: 768px) 440px, 66vw"
            loading={i < 4 || i > slides.length - 4 ? 'eager' : 'lazy'}
            draggable="false"
          />
          <button class="slide__zoom" type="button" tabindex="-1" data-carousel-open aria-label={`Відкрити фото ${(i % gallery.length) + 1}`}>
            <Icon name="cornersOut" size={20} />
          </button>
        </figure>
      ))}
    </div>

    <!-- Caption follows the centre card; controls sit together underneath -->
    <div class="carousel__meta">
      {slides[0].caption && <p class="carousel__caption" aria-live="polite" data-carousel-caption>{slides[0].caption}</p>}
      <div class="carousel__controls">
        <button class="carousel__btn" type="button" data-carousel-prev aria-label="Попереднє фото">
          <Icon name="arrowRight" size={20} class="flip" />
        </button>
        <span class="carousel__count" aria-live="polite">
          <b data-carousel-index>01</b><span class="carousel__sep">/</span>{pad(gallery.length)}
        </span>
        <button class="carousel__btn" type="button" data-carousel-next aria-label="Наступне фото">
          <Icon name="arrowRight" size={20} />
        </button>
      </div>
    </div>
  </div>

  <Lightbox
    id="gallery-viewer"
    label="Перегляд фото"
    items={gallery.map((g, i) => ({ src: full[i].src, alt: g.alt, caption: g.caption }))}
  />
</section>

<style>
  .gallery { padding-top: 0; overflow: clip; }

  /* Reverse coverflow: the centre card faces the viewer, the ones beside it swing their outer
     edges forward. Positions are set per frame by the script, so dragging follows the finger. */
  .carousel { --w: min(66vw, 420px); outline: none; }
  .carousel:focus-visible .carousel__stage { outline: 3px solid var(--blue); outline-offset: 4px; border-radius: var(--radius); }

  .carousel__stage {
    position: relative;
    height: calc(var(--w) * 0.8 + 96px);
    padding-block: 48px; /* room for shadows: the edge mask clips at the stage box */
    margin-block: -48px;
    perspective: calc(var(--w) * 4.5);
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    cursor: grab;
  }
  .carousel__stage.is-dragging { cursor: grabbing; }

  .slide {
    position: absolute;
    top: 48px;
    left: 50%;
    width: var(--w);
    height: calc(var(--w) * 0.8);
    margin: 0 0 0 calc(var(--w) / -2);
    overflow: hidden;
    border-radius: 22px;
    background: var(--tint);
    box-shadow: 0 2px 6px rgb(13 47 156 / 0.06), 0 30px 50px -24px rgb(13 47 156 / 0.3);
    opacity: 0;
    will-change: transform, opacity;
    -webkit-tap-highlight-color: transparent;
  }
  .slide:first-child { opacity: 1; } /* without JS the first photo still shows */
  .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    filter: brightness(var(--b, 1));
  }
  .slide:not(.is-current) { cursor: var(--cursor-link); }
  .slide.is-current { cursor: zoom-in; }

  .slide__zoom {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.9);
    box-shadow: 0 4px 12px -4px rgb(13 47 156 / 0.3);
    color: var(--navy);
    cursor: var(--cursor-link);
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.3s ease, transform 0.3s var(--ease), background-color 0.2s, color 0.2s;
  }
  .slide.is-current .slide__zoom { opacity: 1; transform: none; }
  .slide__zoom:hover,
  .slide__zoom:focus-visible { background: var(--navy); color: #fff; }

  .carousel__meta {
    display: grid;
    justify-items: center;
    gap: 20px;
    margin-top: 28px;
    padding-inline: var(--gutter);
    text-align: center;
  }
  .carousel__caption {
    min-height: 1.4em;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.25rem);
    letter-spacing: -0.01em;
    color: var(--navy);
  }
  .carousel__caption.is-changing { animation: caption-in 0.5s var(--ease); }
  @keyframes caption-in { from { opacity: 0; transform: translateY(6px); } }

  .carousel__controls { display: flex; align-items: center; gap: 12px; }

  /* Photo number between the arrows */
  .carousel__count {
    min-width: 92px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.9375rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  .carousel__count b { font-weight: 600; color: var(--navy); }
  .carousel__sep { margin-inline: 6px; opacity: 0.5; }

  .carousel__btn {
    display: grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: var(--surface);
    box-shadow: var(--shadow);
    color: var(--navy);
    cursor: var(--cursor-link);
    transition: background-color 0.2s, color 0.2s, transform 0.3s var(--ease);
  }
  .carousel__btn:hover { background: var(--navy); color: #fff; transform: translateY(-2px); }
  .carousel :global(.flip) { transform: scaleX(-1); }

  @media (min-width: 900px) {
    /* Far photos melt into the page instead of ending on a hard edge */
    .carousel__stage {
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
      mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    }
  }
  @media (max-width: 639px) {
    .slide { border-radius: 18px; }
    .slide__zoom { width: 36px; height: 36px; top: 10px; right: 10px; }
    .carousel__btn { width: 44px; height: 44px; }
  }
</style>
