---
import Icon from './Icon.astro';
import { org, support } from '../data/site';

const filled = support.requisites.filter((r) => r.value);
const copyAll = filled.map((r) => `${r.label}: ${r.value}`).join('\n');
---

<section class="section support" id="support">
  <div class="container">
    <div class="section-head section-head--center" data-reveal>
      <span class="eyebrow">Підтримати фонд</span>
      <h2>Підтримайте те, що ми створюємо разом</h2>
      <p>
        Ваша підтримка допомагає нам продовжувати роботу, створювати нові можливості для громади та розвивати простір
        для людей різного віку.
      </p>
    </div>

    <div class="support__card" data-reveal style="--d:1">
      <div class="pay">
        <!-- Payments go through the bank's own form; the amount is entered there -->
        <div class="pay__main">
          <h3>Онлайн-внесок</h3>
          <ol class="steps">
            <li><span>1</span>Оберіть ПриватБанк або monobank — відкриється сторінка оплати.</li>
            <li><span>2</span>Вкажіть суму внеску.</li>
            <li><span>3</span>Підтвердіть платіж.</li>
          </ol>
          <div class="pay__actions">
            <a class="btn pay__submit" href={support.payUrl} target="_blank" rel="noopener">
              <span>Підтримати через ПриватБанк</span>
              <Icon name="arrowUpRight" size={18} class="icon--move" />
            </a>
            <a class="btn btn--ghost pay__submit" href={support.monoUrl} target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer">
              <span>Підтримати через monobank</span>
              <Icon name="arrowUpRight" size={18} class="icon--move" />
            </a>
          </div>
        </div>

        <!-- Transparency right next to the ask -->
        <ul class="pay__trust">
          <li>
            <span class="badge" data-accent="blue"><Icon name="sealCheck" size={22} /></span>
            <div>
              <h3>Незалежний аудит</h3>
              <a class="link-arrow" href="#documents">Висновок аудитора <Icon name="arrowRight" size={16} /></a>
            </div>
          </li>
          <li>
            <span class="badge" data-accent="violet"><Icon name="fileText" size={22} /></span>
            <div>
              <h3>Відкриті звіти</h3>
              <a class="link-arrow" href="#documents">Річні звіти <Icon name="arrowRight" size={16} /></a>
            </div>
          </li>
        </ul>
      </div>

      <div class="bank" id="requisites">
        <h3>Реквізити фонду</h3>
        <dl>
          {support.requisites.map((r) => (
            <div class="req">
              <dt>{r.label}</dt>
              <dd>
                {r.value ? (
                  <>
                    <span>{r.value}</span>
                    <button class="copy" type="button" data-copy={r.value} aria-label={`Скопіювати: ${r.label}`}>
                      <Icon name="copy" size={18} class="copy__idle" />
                      <Icon name="check" size={18} class="copy__done" />
                    </button>
                  </>
                ) : (
                  <span class="req__pending">уточнюється</span>
                )}
              </dd>
            </div>
          ))}
        </dl>
        <button class="btn btn--light btn--sm bank__all" type="button" data-copy={copyAll}>
          <Icon name="copy" size={18} class="copy__idle" />
          <Icon name="check" size={18} class="copy__done" />
          Скопіювати всі реквізити
        </button>
      </div>
    </div>

    <div class="partner-strip" data-accent="yellow" data-reveal style="--d:2">
      <span class="badge"><Icon name="buildings" /></span>
      <div>
        <h3>Для бізнесу та великих донорів</h3>
        <p>Партнерства, спонсорство заходів, ґранти — розкажемо, як можемо діяти разом.</p>
      </div>
      <a class="btn btn--ghost btn--sm" href={`mailto:${org.email}?subject=${encodeURIComponent('Підтримка фонду')}`}>
        Написати нам
        <Icon name="arrowRight" size={16} class="icon--move" />
      </a>
    </div>
  </div>
</section>

<style>
  .support {
    background:
      radial-gradient(closest-side, rgb(82 113 255 / 0.1), transparent) 50% 0 / 80% 60% no-repeat,
      var(--bg);
  }

  .support__card {
    display: grid;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
  }

  /* Online payment */
  .pay { display: flex; flex-direction: column; gap: 32px; padding: clamp(var(--card-pad), 4vw, 48px); }

  .pay__trust {
    display: grid;
    gap: 16px;
    margin: auto 0 0;
    padding: 24px 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .pay__trust li { display: flex; align-items: center; gap: 14px; }
  .pay__trust .badge { width: 44px; height: 44px; }
  .pay__trust li > div { display: grid; gap: 2px; justify-items: start; }
  .pay__trust h3 { font-size: 0.9688rem; }
  .pay__trust .link-arrow { font-size: 0.875rem; }
  fieldset { margin: 0; padding: 0; border: 0; min-width: 0; }
  .pay__main { display: grid; gap: 24px; }
  .pay__main h3, .bank h3 { font-size: 1.375rem; }
  .steps { display: grid; gap: 14px; margin: 0; padding: 0; list-style: none; }
  .steps li { display: flex; align-items: center; gap: 14px; font-size: 1.0625rem; color: var(--text); }
  .steps span {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--tint);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--blue-strong);
  }
  .pay__actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .pay__submit { width: 100%; min-height: 60px; padding: 14px 16px; font-size: 1rem; text-align: center; }
  .pay__submit :global(.icon) { flex: none; }

  @media (max-width: 599px) {
    .pay__submit { padding: 14px 10px; font-size: 0.9375rem; }
    .pay__submit :global(.icon) { display: none; }
  }

  /* Bank transfer */
  .bank {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: clamp(var(--card-pad), 4vw, 48px);
    background:
      radial-gradient(closest-side, rgb(82 113 255 / 0.45), transparent) 100% 0 / 70% 60% no-repeat,
      var(--navy);
    color: rgb(255 255 255 / 0.72);
  }
  .bank h3 { color: #fff; }
  .bank dl { margin: 0; }
  .req { padding: 14px 0; border-top: 1px solid rgb(255 255 255 / 0.12); }
  .req dt { font-size: 0.8125rem; color: rgb(255 255 255 / 0.7); }
  .req dd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 2px 0 0;
    font-weight: 700;
    color: #fff;
    overflow-wrap: anywhere;
  }
  .req__pending { font-weight: 600; font-style: italic; color: rgb(255 255 255 / 0.45); }

  .copy {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.1);
    color: #fff;
    cursor: var(--cursor-link);
    transition: background-color 0.2s;
  }
  .copy:hover { background: rgb(255 255 255 / 0.2); }
  .copy :global(.icon) { grid-area: 1 / 1; }
  :global([data-copy]) :global(.copy__done) { display: none; }
  :global([data-copy].is-done) :global(.copy__idle) { display: none; }
  :global([data-copy].is-done) :global(.copy__done) { display: block; }
  .bank__all { justify-self: start; margin-top: 16px; }

  /* Business / large donors */
  .partner-strip {
    display: grid;
    gap: 16px;
    margin-top: 20px;
    padding: var(--card-pad);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .partner-strip h3 { font-size: 1.125rem; margin-bottom: 4px; }
  .partner-strip p { font-size: 0.9375rem; color: var(--muted); }
  .partner-strip .btn { justify-self: start; }

  @media (min-width: 900px) {
    .support__card { grid-template-columns: 1.2fr 1fr; }
    .pay__trust { grid-template-columns: 1fr 1fr; }
    .partner-strip { grid-template-columns: auto 1fr auto; align-items: center; gap: 20px; }
  }
</style>
