---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { instagramUrl, media, posts } from '../data/site';

const MEDIA_SHOWN = 8;

// What opens behind a media link, read from its URL, so the visitor knows before clicking
type Kind = { label: string; icon: 'playCircle' | 'article' | 'chatDots' };
const kindOf = (url: string): Kind => {
  if (/youtu\.?be/.test(url)) return { label: 'Відео · YouTube', icon: 'playCircle' };
  if (url.includes('facebook.com/share/v/')) return { label: 'Відео · Facebook', icon: 'playCircle' };
  if (url.includes('facebook.com')) return { label: 'Допис · Facebook', icon: 'chatDots' };
  return { label: 'Стаття', icon: 'article' };
};
const tabs = [
  { id: 'news', label: 'Новини та можливості' },
  { id: 'media', label: 'Медіа про нас' },
];
---

<section class="section news" id="news">
  <div class="container">
    <div class="news__head">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Актуальне</span>
        <h2>Новини, події та можливості</h2>
      </div>
      <div class="pills" role="tablist" aria-label="Розділи" data-reveal data-tabs>
        {tabs.map((t, i) => (
          <button
            class:list={['pill', { 'is-active': i === 0 }]}
            type="button"
            role="tab"
            id={`tab-${t.id}`}
            aria-controls={`panel-${t.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            {t.label}
          </button>
        ))}
      </div>
    </div>

    <div class="news__panel" role="tabpanel" id="panel-news" aria-labelledby="tab-news">
      <ul class="news__grid">
        {posts.map((p, j) => (
          <li class="post" data-reveal style={`--d:${j}`}>
            {p.image && (
              <div class="post__media">
                <Image src={p.image} alt="" widths={[400, 640]} sizes="(min-width: 1024px) 380px, 92vw" />
              </div>
            )}
            <div class="post__body">
              <p class="post__meta">
                <span class="post__tag">{p.tag}</span>
                {p.date && <span><Icon name="calendar" size={16} />{p.date}</span>}
              </p>
              <h3><a href={p.url} target="_blank" rel="noopener">{p.title}</a></h3>
              <p>{p.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <!-- Media: a compact list of links, the newest first -->
    <div class="news__panel" role="tabpanel" id="panel-media" aria-labelledby="tab-media" hidden>
      <ul class="media">
        {media.slice(0, MEDIA_SHOWN).map((m) => (
          <li>
            <a class="media__item" href={m.url} target="_blank" rel="noopener">
              <span class="media__meta">
                <span class="media__source">{m.source}</span>
                <span class="media__kind"><Icon name={kindOf(m.url).icon} size={14} />{kindOf(m.url).label}</span>
              </span>
              <span class="media__title">{m.title}</span>
              <span class="media__go" aria-hidden="true"><Icon name="arrowUpRight" size={18} /></span>
            </a>
          </li>
        ))}
      </ul>
      {media.length > MEDIA_SHOWN && (
        <details class="media__rest">
          <summary class="btn btn--ghost">Показати всі · {media.length}</summary>
          <ul class="media">
            {media.slice(MEDIA_SHOWN).map((m) => (
              <li>
                <a class="media__item" href={m.url} target="_blank" rel="noopener">
                  <span class="media__meta">
                    <span class="media__source">{m.source}</span>
                    <span class="media__kind"><Icon name={kindOf(m.url).icon} size={14} />{kindOf(m.url).label}</span>
                  </span>
                  <span class="media__title">{m.title}</span>
                  <span class="media__go" aria-hidden="true"><Icon name="arrowUpRight" size={18} /></span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      )}
    </div>

    <div class="news__more" data-reveal>
      <a class="btn btn--ghost" href={instagramUrl} target="_blank" rel="noopener">
        Усі новини та можливості
        <Icon name="arrowUpRight" size={18} />
      </a>
    </div>
  </div>
</section>

<style>
  .news__head { display: grid; gap: 8px; margin-bottom: var(--head-gap); }
  .news__head .section-head { margin-bottom: 16px; }


  .news__grid { display: grid; gap: 20px; margin: 0; padding: 0; list-style: none; }
  .post {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 10px;
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }
  .post:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .post__media { overflow: hidden; aspect-ratio: 16 / 9; border-radius: calc(var(--radius) - 8px); background: var(--tint); }
  .post__media img { width: 100%; height: 100%; object-fit: cover; }
  .post__body { display: grid; gap: 10px; padding: 18px 14px 14px; }
  .post__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; font-size: 0.8125rem; color: var(--muted); }
  .post__meta span { display: inline-flex; align-items: center; gap: 6px; }
  .post__tag { padding: 4px 10px; border-radius: 999px; background: var(--tint); font-weight: 800; color: var(--blue-strong); }
  .post h3 a { text-decoration: none; }
  .post h3 a::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius); }
  .post__body > p:last-child { color: var(--muted); font-size: 0.9688rem; }

  /* Media list */
  .media { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .media__item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 20px;
    align-items: center;
    padding: 18px 20px 18px 24px;
    border-radius: var(--radius-sm);
    background: var(--surface);
    box-shadow: var(--shadow);
    text-decoration: none;
    color: var(--text);
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .media__item:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); }
  .media__meta { grid-column: 1; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; }
  .media__source { font-size: 0.8125rem; font-weight: 800; color: var(--blue-strong); }
  /* Content type: a small chip so the visitor knows whether a video, a post or an article opens */
  .media__kind {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px 3px 7px;
    border-radius: 999px;
    background: var(--tint);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--navy);
  }
  .media__title { grid-column: 1; font-weight: 700; line-height: 1.4; color: var(--navy); }
  .media__go {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--tint);
    color: var(--navy);
    transition: background-color 0.2s, color 0.2s;
  }
  .media__item:hover .media__go { background: var(--navy); color: #fff; }
  .media__rest { margin-top: 10px; }
  .media__rest summary { display: flex; width: fit-content; margin: 22px auto 0; list-style: none; }
  .media__rest summary::-webkit-details-marker { display: none; }
  .media__rest[open] summary { display: none; }

  .news__more { display: flex; justify-content: center; margin-top: clamp(32px, 4vw, 48px); }

  /* Phones: the tabs sit close to the cards they switch */
  @media (max-width: 1023px) {
    .news__head { margin-bottom: 20px; }
  }
  @media (min-width: 640px) {
    .news__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .news__head { grid-template-columns: 1fr auto; align-items: end; }
    .news__head .section-head { margin-bottom: 0; }
    .news__grid { grid-template-columns: repeat(3, 1fr); gap: 24px; }
  }
</style>
