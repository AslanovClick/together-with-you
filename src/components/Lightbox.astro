---
// Full-screen viewer for a set of images (gallery photos, documents).
// Open it from the page with a trigger: data-lightbox-open="<id>" data-index="<n>",
// or from a script: viewer.dispatchEvent(new CustomEvent('lightbox:open', { detail: n })).
import Icon from './Icon.astro';

interface Item {
  src: string;
  alt: string;
  caption: string;
  link?: string | null;
}
interface Props {
  id: string;
  label: string;
  items: Item[];
  linkLabel?: string;
  /** Width / height of the frame; every item is shown in a frame of exactly this shape */
  ratio?: number;
  /** cover fills the frame (photos), contain shows the whole image on a light sheet (documents) */
  fit?: 'cover' | 'contain';
}

const { id, label, items, linkLabel = 'Відкрити', ratio = 3 / 2, fit = 'cover' } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const many = items.length > 1;
---

<dialog class="lightbox" id={id} data-lightbox aria-label={label} style={`--ratio: ${ratio}; --fit: ${fit}`} data-fit={fit}>
  <ul hidden data-lightbox-items>
    {items.map((it) => (
      <li data-src={it.src} data-alt={it.alt} data-caption={it.caption} data-link={it.link ?? ''}>{it.caption}</li>
    ))}
  </ul>

  <figure class="lightbox__figure">
    <!-- One frame shape for every item, sized to fit the screen; the caption below matches its width -->
    <div class="lightbox__frame">
      <img data-lightbox-img src="" alt="" />
    </div>
    <!-- Number above the title on the left; paging arrows (and the link) right under the image -->
    <figcaption class="lightbox__bar">
      <div class="lightbox__meta">
        {many && <span class="lightbox__count"><b data-lightbox-index>01</b> / {pad(items.length)}</span>}
        <span class="lightbox__caption" data-lightbox-caption></span>
      </div>
      <div class="lightbox__actions">
        <a class="btn btn--light btn--sm lightbox__link" href="#" target="_blank" rel="noopener" data-lightbox-link hidden>
          {linkLabel}
          <Icon name="arrowUpRight" size={16} class="icon--move" />
        </a>
        {many && (
          <div class="lightbox__nav">
            <button class="lightbox__btn" type="button" data-lightbox-prev aria-label="Попереднє">
              <Icon name="arrowRight" size={20} class="flip" />
            </button>
            <button class="lightbox__btn" type="button" data-lightbox-next aria-label="Наступне">
              <Icon name="arrowRight" size={20} />
            </button>
          </div>
        )}
      </div>
    </figcaption>
  </figure>

  <button class="lightbox__btn lightbox__close" type="button" data-lightbox-close aria-label="Закрити">
    <Icon name="x" size={22} />
  </button>
</dialog>

<style>
  .lightbox {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: clamp(16px, 4vw, 48px) clamp(16px, 7vw, 112px);
    border: 0;
    background: transparent;
    color: #fff;
  }
  .lightbox[open] { display: grid; place-items: center; animation: lb-in 0.35s ease; }
  .lightbox::backdrop {
    background: rgb(6 16 52 / 0.9);
    backdrop-filter: blur(6px);
  }
  @keyframes lb-in { from { opacity: 0; } }

  /* --chrome: vertical room for the page padding and the bar under the image */
  .lightbox { --chrome: 210px; }
  .lightbox__figure {
    display: grid;
    gap: 20px;
    width: min(100%, 1280px, calc((100dvh - var(--chrome)) * var(--ratio)));
    margin: 0;
  }
  .lightbox__frame {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: 16px;
    background: rgb(255 255 255 / 0.06);
    box-shadow: 0 24px 60px -24px rgb(0 0 0 / 0.45);
  }
  .lightbox[data-fit='contain'] .lightbox__frame { background: #fff; }
  .lightbox__frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: var(--fit);
    transition: opacity 0.25s ease;
  }
  .lightbox[data-fit='contain'] .lightbox__frame img { padding: 12px; }
  .lightbox__frame img.is-loading { opacity: 0; }

  /* Positioned so it paints above the frame's shadow */
  .lightbox__bar {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
  }
  .lightbox__meta { display: grid; gap: 4px; flex: 1; min-width: 0; align-content: center; }
  .lightbox__caption:empty { display: none; } /* photos without a caption: the number centres on the arrows */
  .lightbox__count {
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    color: rgb(255 255 255 / 0.7);
  }
  .lightbox__count b { color: #fff; }
  .lightbox__caption {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.1875rem);
    line-height: 1.25;
    overflow-wrap: break-word;
  }
  .lightbox__actions { display: flex; align-items: center; gap: 12px; }
  .lightbox__nav { display: flex; gap: 8px; }
  .lightbox__link[hidden] { display: none; }

  .lightbox__btn {
    display: grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    cursor: var(--cursor-link);
    transition: background-color 0.2s, color 0.2s;
  }
  .lightbox__btn:hover,
  .lightbox__btn:focus-visible { background: #fff; color: var(--navy); }
  .lightbox__close { position: fixed; top: 16px; right: 16px; }
  .lightbox :global(.flip) { transform: scaleX(-1); }
  :global(html:has(.lightbox[open])) { overflow: hidden; }

  @media (min-width: 900px) {
    .lightbox__close { top: 24px; right: 28px; }
  }
  /* Phones: room above for the close button; number, title and arrows on one row,
     the link button on its own full-width row below */
  @media (max-width: 639px) {
    .lightbox { --chrome: 220px; padding: 76px 16px 24px; }
    .lightbox:has(.lightbox__link:not([hidden])) { --chrome: 280px; }
    .lightbox__actions { display: contents; }
    .lightbox__link { order: 3; flex: 1 1 100%; justify-content: center; min-height: 48px; }
    .lightbox__btn { width: 46px; height: 46px; }
  }
</style>
