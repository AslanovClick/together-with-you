---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { projects } from '../data/site';

const PAGE = 3;
// The fund lists projects oldest first; the page shows the newest first.
const list = [...projects].reverse();
const years = [...new Set(list.map((p) => p.year))];
---

<section class="section projects" id="projects">
  <div class="container">
    <div class="projects__head">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Реалізовані проєкти</span>
        <h2>Що ми вже створили разом</h2>
      </div>
      <div class="pills" role="toolbar" aria-label="Фільтр за роками" data-reveal>
        <button class="pill is-active" type="button" data-filter="all" aria-pressed="true">
          Усі
        </button>
        {years.map((y) => (
          <button class="pill" type="button" data-filter={String(y)} aria-pressed="false">
            {y}
          </button>
        ))}
      </div>
    </div>

    <div class="projects__grid" data-projects data-page={PAGE}>
      {list.map((p, i) => (
        <article class="project" data-tags={String(p.year)} hidden={i >= PAGE}>
          <div class="project__media">
            <Image src={p.image} alt="" widths={[400, 640]} sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 92vw" />
            <span class="project__year">{p.year}</span>
          </div>
          <div class="project__body">
            <h3>
              <button type="button" data-project-open={i} aria-haspopup="dialog">{p.title}</button>
            </h3>
            <p>{p.body[0]}</p>
            <span class="project__more" aria-hidden="true">
              Читати повністю <Icon name="arrowRight" size={16} />
            </span>
          </div>

          <!-- Full description for the dialog, word for word as provided by the fund -->
          <template data-project-tpl={i}>
            <div class="pd__media">
              <Image src={p.image} alt="" widths={[640, 960]} sizes="(min-width: 800px) 760px, 100vw" />
            </div>
            <div class="pd__body">
              <span class="pd__year">{p.year}</span>
              <h3 class="pd__title" id="project-dialog-title">{p.title}</h3>
              {p.body.map((t) => <p>{t}</p>)}
              {p.links.length > 0 && (
                <div class="pd__links">
                  <span>Більше інформації:</span>
                  {p.links.map((l) => (
                    <a class="btn btn--ghost btn--sm" href={l.url} target="_blank" rel="noopener">
                      {l.label}
                      <Icon name="arrowUpRight" size={16} class="icon--move" />
                    </a>
                  ))}
                </div>
              )}
            </div>
          </template>
        </article>
      ))}
    </div>

    <div class="projects__more">
      <button class="btn btn--ghost" type="button" data-projects-more>
        Показати ще <span data-projects-rest>{list.length - PAGE}</span>
      </button>
    </div>
  </div>

  <dialog class="pd" data-project-dialog aria-labelledby="project-dialog-title">
    <div class="pd__sheet">
      <button class="pd__close" type="button" data-project-close aria-label="Закрити">
        <Icon name="x" size={22} />
      </button>
      <div class="pd__content" data-project-content></div>
    </div>
  </dialog>
</section>

<style>
  .projects__head {
    display: grid;
    gap: 8px;
    margin-bottom: var(--head-gap);
  }
  .projects__head .section-head { margin-bottom: 16px; }

  .projects__grid {
    display: grid;
    gap: 20px;
  }
  .project {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 10px;
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
    animation: card-in 0.6s var(--ease) both;
  }
  .project[hidden] { display: none; }
  .project:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  @keyframes card-in { from { opacity: 0; transform: translateY(16px); } }

  .project__media {
    position: relative;
    overflow: hidden;
    border-radius: calc(var(--radius) - 8px);
    aspect-ratio: 16 / 10;
    background: var(--tint);
  }
  .project__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .project:hover .project__media img { transform: scale(1.04); }
  .project__year,
  .pd__year {
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--surface);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.8125rem;
    color: var(--navy);
  }
  .project__year { position: absolute; top: 12px; left: 12px; box-shadow: var(--shadow); }

  .project__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
    padding: 18px 14px 14px;
  }
  .project h3 { font-size: 1.125rem; line-height: 1.3; }
  /* The title button covers the whole card */
  .project h3 button {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    color: inherit;
    cursor: var(--cursor-link);
  }
  .project h3 button::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius); }
  .project h3 button:focus-visible { outline: none; }
  .project:has(h3 button:focus-visible) { outline: 3px solid var(--blue); outline-offset: 3px; }
  .project__body > p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.9688rem;
  }
  .project__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 6px;
    font-weight: 800;
    font-size: 0.9375rem;
    color: var(--blue-strong);
  }
  .project__more :global(.icon) { transition: transform 0.25s var(--ease); }
  .project:hover .project__more :global(.icon) { transform: translateX(4px); }

  .projects__more { display: flex; justify-content: center; margin-top: clamp(32px, 4vw, 48px); }
  .projects__more[hidden], .projects__more:has(button[hidden]) { display: none; }
  .projects__more span {
    display: inline-grid;
    place-items: center;
    min-width: 28px;
    height: 28px;
    padding: 0 8px;
    border-radius: 999px;
    background: var(--tint);
    font-size: 0.875rem;
  }

  /* Project dialog: a white sheet that scrolls inside the window */
  .pd {
    width: min(100% - 32px, 820px);
    max-width: none;
    max-height: calc(100dvh - 48px);
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: 0 40px 100px -30px rgb(6 16 52 / 0.5);
    color: var(--text);
    overflow: hidden;
  }
  .pd[open] { display: flex; animation: pd-in 0.35s var(--ease); }
  .pd::backdrop { background: rgb(6 16 52 / 0.72); backdrop-filter: blur(4px); }
  @keyframes pd-in { from { opacity: 0; transform: translateY(16px); } }
  .pd__sheet { position: relative; flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; }
  .pd__close {
    position: sticky;
    top: 16px;
    z-index: 2;
    float: right;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin: 16px 16px -64px 0;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    box-shadow: var(--shadow);
    color: var(--navy);
    cursor: var(--cursor-link);
    transition: background-color 0.2s, color 0.2s;
  }
  .pd__close:hover { background: var(--navy); color: #fff; }
  .pd__content :global(.pd__media) { aspect-ratio: 16 / 9; background: var(--tint); }
  .pd__content :global(.pd__media img) { width: 100%; height: 100%; object-fit: cover; }
  .pd__content :global(.pd__body) {
    display: grid;
    gap: 16px;
    justify-items: start;
    padding: clamp(24px, 4vw, 40px);
  }
  .pd__content :global(.pd__year) { background: var(--tint); }
  .pd__content :global(.pd__title) { font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem); line-height: 1.2; }
  .pd__content :global(.pd__body p) { font-size: 1.0625rem; color: var(--text); }
  .pd__content :global(.pd__links) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    width: 100%;
  }
  .pd__content :global(.pd__links > span) { font-weight: 700; color: var(--muted); margin-right: 4px; }
  :global(html:has(.pd[open])) { overflow: hidden; }

  /* Phones: the filter row sits close to the cards it filters; the dialog fills the screen */
  @media (max-width: 1023px) {
    .projects__head { margin-bottom: 20px; }
  }
  @media (max-width: 639px) {
    .pd { width: 100%; max-height: 100dvh; height: 100dvh; border-radius: 0; }
  }
  @media (min-width: 640px) {
    .projects__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .projects__head { grid-template-columns: 1fr auto; align-items: end; }
    .projects__head .section-head { margin-bottom: 0; }
    .projects__grid { grid-template-columns: repeat(3, 1fr); gap: 24px; }
  }
</style>
