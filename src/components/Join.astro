---
import Icon from './Icon.astro';
import { org, roles, socials } from '../data/site';

const contacts = [
  { label: 'Телефон', value: org.phone, href: org.phoneHref, icon: 'phone' as const, accent: 'yellow' },
  { label: 'Email', value: org.email, href: `mailto:${org.email}`, icon: 'envelope' as const, accent: 'coral' },
  { label: 'Адреса простору', value: org.address, href: org.mapUrl, icon: 'mapPin' as const, accent: 'violet', external: true },
];
---

<section class="section join" id="join">
  <span class="join__disc join__disc--1"></span>
  <span class="join__disc join__disc--2"></span>
  <span class="join__disc join__disc--3"></span>

  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Долучайтеся</span>
      <h2>Долучайтеся до спільноти</h2>
      <p>
        Ви можете долучитися як учасник, волонтер, партнер, благодійник або просто людина, якій важливо, що
        відбувається поруч.
      </p>
    </div>

    <ul class="roles">
      {roles.map((r, i) => (
        <li class="role" data-accent={r.accent} data-reveal style={`--d:${i}`}>
          <div class="card-head">
            <span class="badge"><Icon name={r.icon} /></span>
            <h3>{r.title}</h3>
          </div>
          <p>{r.text}</p>
          <a
            class="link-arrow"
            href={r.href}
            {...(r.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {r.cta}
            <Icon name="arrowRight" size={16} />
          </a>
        </li>
      ))}
    </ul>

    <div class="contacts" id="contacts">
      <div class="contacts__intro" data-reveal>
        <h2>Будьмо на зв’язку</h2>
        <p>Пишіть, телефонуйте або приходьте у простір — ми завжди раді знайомству.</p>
        <div class="socials">
          {socials.filter((s) => s.url).map((s) => (
            <a href={s.url!} target="_blank" rel="noopener" aria-label={s.name}>
              <Icon name={s.icon} size={24} />
            </a>
          ))}
        </div>
      </div>

      <ul class="contacts__list">
        {contacts.map((c, i) => (
          <li data-accent={c.accent} data-reveal style={`--d:${i}`}>
            <a href={c.href} {...(c.external ? { target: '_blank', rel: 'noopener' } : {})}>
              <span class="badge"><Icon name={c.icon} /></span>
              <span>
                <small>{c.label}</small>
                <strong>{c.value}</strong>
              </span>
              <Icon name="arrowUpRight" size={20} class="contacts__arrow" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .join {
    background: var(--navy);
    color: rgb(255 255 255 / 0.75);
    overflow: hidden;
    isolation: isolate;
  }
  .join h2, .join h3 { color: #fff; }
  .join .eyebrow { color: var(--yellow); }
  .join .section-head p { color: rgb(255 255 255 / 0.75); }

  .join__disc { position: absolute; border-radius: 50%; z-index: -1; pointer-events: none; }
  .join__disc--1 { width: 460px; height: 460px; right: -140px; top: -160px; background: var(--blue); opacity: 0.55; }
  .join__disc--2 { width: 300px; height: 300px; right: 180px; top: -200px; background: var(--violet); opacity: 0.35; }
  .join__disc--3 { width: 220px; height: 220px; right: 60px; top: 160px; background: var(--coral); opacity: 0.25; }
  /* On narrow screens the discs land on top of the text, so a soft corner light replaces them */
  @media (max-width: 899px) {
    .join__disc { display: none; }
    .join {
      background:
        radial-gradient(closest-side, rgb(82 113 255 / 0.45), transparent) 100% 0 / 90% 40% no-repeat,
        var(--navy);
    }
  }

  .roles { display: grid; gap: 16px; margin: 0; padding: 0; list-style: none; }
  .role {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: var(--card-pad);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.06);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    backdrop-filter: blur(6px);
    transition: background-color 0.3s, transform 0.35s var(--ease);
  }
  .role:hover { background: rgb(255 255 255 / 0.1); transform: translateY(-4px); }
  /* On navy the tiles go glassy and the icon takes the accent colour */
  .join .badge { background: rgb(255 255 255 / 0.08); color: var(--accent); }
  /* CTA pinned to the bottom so all cards line up */
  .role .link-arrow { margin-top: auto; padding-top: 8px; color: #fff; }

  .contacts {
    display: grid;
    gap: 32px;
    margin-top: var(--block);
    padding-top: var(--block);
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }
  .contacts__intro { display: grid; gap: 16px; align-content: start; }
  .contacts__intro h2 { font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.5rem); }
  .socials { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  .socials a {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    color: #fff;
    transition: background-color 0.2s, transform 0.3s var(--ease);
  }
  .socials a:hover { background: var(--blue-strong); transform: translateY(-3px); }

  .contacts__list { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
  .contacts__list a {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.06);
    text-decoration: none;
    transition: background-color 0.25s;
  }
  .contacts__list a:hover { background: rgb(255 255 255 / 0.12); }
  .contacts__list a > span:nth-child(2) { display: grid; flex: 1; min-width: 0; }
  .contacts__list small { font-size: 0.8125rem; color: rgb(255 255 255 / 0.6); }
  /* The e-mail stays on one line: its font shrinks with the card instead of breaking the address */
  .contacts__list a { container-type: inline-size; }
  .contacts__list strong { color: #fff; font-size: 1.0625rem; overflow-wrap: break-word; }
  .contacts__list a[href^='mailto:'] strong { font-size: min(1.0625rem, calc((100cqi - 140px) / 12.5)); white-space: nowrap; }
  .contacts__list :global(.contacts__arrow) { flex: none; color: rgb(255 255 255 / 0.5); }

  @media (min-width: 640px) {
    .roles { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .roles { grid-template-columns: repeat(4, 1fr); gap: 20px; }
    .contacts { grid-template-columns: 0.8fr 1.2fr; gap: 64px; }
  }
</style>
