---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Audiences from '../components/Audiences.astro';
import Directions from '../components/Directions.astro';
import Stats from '../components/Stats.astro';
import Projects from '../components/Projects.astro';
import Gallery from '../components/Gallery.astro';
import Growth from '../components/Growth.astro';
import Partners from '../components/Partners.astro';
import Support from '../components/Support.astro';
import News from '../components/News.astro';
import Join from '../components/Join.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Header />
  <main id="main">
    <Hero />
    <About />
    <Audiences />
    <Directions />
    <Stats />
    <Projects />
    <Gallery />
    <Growth />
    <Partners />
    <Support />
    <News />
    <Join />
  </main>
  <Footer />
</Base>
